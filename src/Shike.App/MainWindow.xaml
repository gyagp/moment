<Window x:Class="Shike.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时刻">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Padding="32,24,32,24" Spacing="22" MaxWidth="1120" HorizontalAlignment="Stretch">
        <Grid>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="44" Height="44" CornerRadius="12" Background="#127C72">
              <FontIcon Glyph="&#xE823;" Foreground="White" FontSize="25" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="时刻" FontSize="23" FontWeight="SemiBold" />
              <TextBlock Text="SHIKE · 屏幕里的每一个瞬间" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
          <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5">
            <TextBlock Text="0.1.1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </Border>
        </Grid>

        <StackPanel Spacing="6">
          <TextBlock Text="把这一刻，留下来。" FontSize="32" FontWeight="SemiBold" />
          <TextBlock Text="一张截图，一段长页面，或一段正在发生的故事。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel Spacing="12">
              <FontIcon Glyph="&#xE722;" HorizontalAlignment="Left" FontSize="28" Foreground="#15998B" />
              <TextBlock Text="屏幕截图" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="矩形、窗口、全屏或任意形状。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinHeight="38" />
              <Button x:Name="ScreenshotButton" Content="新建截图" Click="Screenshot_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
              <TextBlock Text="Ctrl + Shift + S" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel Spacing="12">
              <SymbolIcon Symbol="Page" Width="28" Height="28" HorizontalAlignment="Left" Foreground="#15998B" />
              <TextBlock Text="滚动截图" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="自动滚动并拼接，你只需停止。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinHeight="38" />
              <Button x:Name="ScrollButton" Content="截取长图 · 实验" Click="Scroll_Click" HorizontalAlignment="Stretch" />
              <TextBlock Text="Ctrl + Shift + L" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel Spacing="12">
              <FontIcon Glyph="&#xE714;" HorizontalAlignment="Left" FontSize="28" Foreground="#D86853" />
              <TextBlock Text="屏幕录制" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="录制所选显示器，保存为 MP4。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinHeight="38" />
              <Button x:Name="RecordButton" Content="开始录屏" Click="Record_Click" HorizontalAlignment="Stretch" />
              <TextBlock Text="Ctrl + Shift + R" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="18,14">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="长截图 / 录屏显示器" VerticalAlignment="Center" />
              <ComboBox x:Name="DisplayPicker" Grid.Column="1" DisplayMemberPath="Label" HorizontalAlignment="Stretch" AutomationProperties.Name="捕获显示器" />
              <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新" Click="Refresh_Click" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="20">
              <CheckBox x:Name="SystemAudioCheck" Content="录制系统声音" IsChecked="True" />
              <CheckBox x:Name="MicrophoneCheck" Content="录制麦克风" IsChecked="False" />
              <TextBlock Text="H.264 · 30 fps" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </Border>

        <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="准备就绪"
                 Message="新建截图后选择矩形、窗口、全屏或任意形状。滚动截图会自动滚动，Ctrl + Shift + F 停止并保存。" />
        <StackPanel x:Name="SessionControls" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
          <Button x:Name="PauseButton" Content="暂停录制" Click="Pause_Click" />
          <Button x:Name="StopButton" Content="结束并保存" Click="Stop_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="最近一次捕获" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="截图文件夹" Click="ImageFolder_Click" />
            <Button Content="录屏文件夹" Click="VideoFolder_Click" />
          </StackPanel>
        </Grid>
        <Border MinHeight="150" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock x:Name="EmptyText" Text="截下第一张图片，让这一刻有迹可循。" HorizontalAlignment="Center" Margin="0,35" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Image x:Name="PreviewImage" MaxHeight="240" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="最近截图预览" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="ResultActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
              <Button Content="打开文件" Click="OpenResult_Click" />
              <Button x:Name="CopyButton" Content="复制图片" Click="Copy_Click" />
              <Button Content="在文件夹中显示" Click="RevealResult_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ShortcutText" Text="内容保存在本机 · 截图与录屏均不会上传" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
